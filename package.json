{
  "name": "lookify",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis directus",
    "dev:realtime": "npm --workspace apps/realtime-server run dev",
    "dev:app": "npm --workspace apps/lookify-app run start",
    "env:lan": "node scripts/sync-lan-env.mjs",
    "dev:lan-proxy": "node scripts/lan-proxy.mjs 8055",
    "db:setup": "node scripts/db-setup.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:cleanup:gps": "node scripts/gps-cleanup.mjs",
    "db:seed": "node directus/seed.mjs",
    "seed:demo": "node directus/seed-demo.mjs",
    "db:fresh": "npm run db:setup && npm run db:migrate && npm run db:seed",
    "check:parity": "node scripts/check-parity.mjs",
    "typecheck": "npx tsc --noEmit -p apps/realtime-server && npx tsc --noEmit -p apps/lookify-app && npm run check:parity",
    "db:cleanup:radar": "node scripts/radar-cleanup.mjs"
  },
  "dependencies": {
    "expo": "58.0.24",
    "expo-splash-screen": "58.0.14",
    "express": "^5.2.1"
  }
}
