{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "directus": {
      "type": "local",
      "command": ["npx", "-y", "@directus/content-mcp@latest"],
      "environment": {
        "DIRECTUS_URL": "http://localhost:8055",
        "DIRECTUS_TOKEN": "{env:DIRECTUS_TOKEN}"
      },
      "enabled": true
    }
  }
}
