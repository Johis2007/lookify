{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "directus": {
      "type": "local",
      "command": ["npx", "-y", "@directus/content-mcp@latest"],
      "environment": {
        "DIRECTUS_URL": "http://localhost:8055",
        "DIRECTUS_TOKEN": "{env:DIRECTUS_TOKEN}"
      },
      "enabled": true
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    }
  }
}
