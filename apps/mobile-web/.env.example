# Expo / App — multi-red con fallback automático (casa <-> universidad).
# La primaria es la red actual; las listas *_URLS conservan TODAS las redes
# conocidas y el cliente prueba cada una (lib/endpoints) hasta conectar.
# Regenerar al cambiar de Wi-Fi:  npm run env:lan  (desde la raíz del repo)
EXPO_PUBLIC_DIRECTUS_URL=http://192.168.1.8:8055
EXPO_PUBLIC_DIRECTUS_URLS=http://192.168.1.8:8055,http://10.157.39.169:8055
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.8:4001
EXPO_PUBLIC_SOCKET_URLS=http://192.168.1.8:4001,http://10.157.39.169:4001
EXPO_PUBLIC_GOOGLE_MAPS_KEY=tu_google_maps_api_key_aqui

# Backend (Docker Compose)
DB_DATABASE=lookify
DB_USER=lookify
DB_PASSWORD=lookify_pwd
DB_HOST=localhost
DB_PORT=5432

DIRECTUS_KEY=cambiar-key-32chars-minimo
DIRECTUS_SECRET=cambiar-secret-32chars-minimo
ADMIN_EMAIL=admin@lookify.app
ADMIN_PASSWORD=Lookify123!
PUBLIC_URL=http://localhost:8055