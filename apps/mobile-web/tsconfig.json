{
  // Ruta relativa (en vez de "expo/tsconfig.base"): en monorepo con
  // node_modules hoisted a la raíz, VS Code no siempre resuelve el
  // especificador bare según la carpeta abierta. Así es determinista.
  "extends": "../../node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
