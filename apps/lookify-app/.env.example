# Variables de la app (Expo las expone con prefijo EXPO_PUBLIC_).

# Backend Lookify: Directus + realtime-server (ver docs/adaptacion-backend.md).
# Con USE_BACKEND=false (default) la app usa mocks locales.
EXPO_PUBLIC_USE_BACKEND=false
EXPO_PUBLIC_DIRECTUS_URL=http://localhost:8055
EXPO_PUBLIC_SOCKET_URL=http://localhost:4001

# Google Maps (solo nativo con PROVIDER_GOOGLE; web usa Leaflet sin key).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
