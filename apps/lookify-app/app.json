{
  "expo": {
    "name": "lookify-app",
    "slug": "lookify-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lookify",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lookify.app"
    },
    "android": {
      "package": "com.lookify.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lookify necesita acceder a tus fotos para subir certificados.",
          "cameraPermission": "Lookify necesita usar la cámara para fotografiar certificados."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lookify usa tu ubicación en primer plano para mostrarte como disponible a clientes cercanos."
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-lookify.png",
          "resizeMode": "contain",
          "backgroundColor": "#1F4E5A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a56f4b77-76f4-4628-b46c-9270b8c885cb"
      }
    },
    "owner": "jeff67100"
  }
}
