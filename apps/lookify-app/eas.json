{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_USE_BACKEND": "true",
        "EXPO_PUBLIC_BFF_URL": "http://192.168.1.90:4001",
        "EXPO_PUBLIC_SOCKET_URL": "http://192.168.1.90:4001",
        "EXPO_PUBLIC_SOCKET_URLS": "http://192.168.1.90:4001",
        "EXPO_PUBLIC_DIRECTUS_URL": "http://192.168.1.90:8055",
        "EXPO_PUBLIC_DIRECTUS_URLS": "http://192.168.1.90:8055"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_BACKEND": "true",
        "EXPO_PUBLIC_BFF_URL": "http://192.168.1.90:4001",
        "EXPO_PUBLIC_SOCKET_URL": "http://192.168.1.90:4001",
        "EXPO_PUBLIC_SOCKET_URLS": "http://192.168.1.90:4001",
        "EXPO_PUBLIC_DIRECTUS_URL": "http://192.168.1.90:8055",
        "EXPO_PUBLIC_DIRECTUS_URLS": "http://192.168.1.90:8055"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_BACKEND": "true",
        "EXPO_PUBLIC_BFF_URL": "https://bff.tu-dominio.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://bff.tu-dominio.com",
        "EXPO_PUBLIC_SOCKET_URLS": "https://bff.tu-dominio.com",
        "EXPO_PUBLIC_DIRECTUS_URL": "https://directus.tu-dominio.com",
        "EXPO_PUBLIC_DIRECTUS_URLS": "https://directus.tu-dominio.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
