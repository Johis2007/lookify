# Variables de la app (Expo las expone con prefijo EXPO_PUBLIC_).

# Backend Lookify: Directus + realtime-server (ver docs/adaptacion-backend.md).
# Con USE_BACKEND=false (default) la app usa mocks locales.
EXPO_PUBLIC_USE_BACKEND=false
EXPO_PUBLIC_DIRECTUS_URL=http://localhost:8055
EXPO_PUBLIC_SOCKET_URL=http://localhost:4001
# UUID del rol "App User". Ya NO hay que copiarlo a mano: `npm run db:fresh`
# lo escribe solo en apps/lookify-app/.env (ver directus/setup-permissions.mjs).
EXPO_PUBLIC_APP_ROLE_ID=<se-autogenera-con-db:fresh>

# Google Maps (solo nativo con PROVIDER_GOOGLE; web usa Leaflet sin key).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# --- Infraestructura (docker compose + scripts db:*) ---
# Copia este archivo a .env y CAMBIA estos valores por unos fuertes.
# Genera claves con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_DATABASE=lookify
DB_USER=lookify
DB_PASSWORD=cambiar-clave-postgres
DIRECTUS_KEY=cambiar-key-32chars-minimo
DIRECTUS_SECRET=cambiar-secret-32chars-minimo
ADMIN_EMAIL=admin@lookify.app
PUBLIC_URL=http://localhost:8055
# Token estático de servicio para el BFF (solo directus_files). Generado por directus/setup-permissions.mjs.
DIRECTUS_TOKEN=

# --- Datos de demostración (npm run seed:demo) ---
# Contraseña de cliente.demo@lookify.app y pro.demo@lookify.app.
# Solo desarrollo: define aquí un valor y ejecuta `npm run seed:demo`.
DEMO_PASSWORD=

# --- Scripts db:* (opcionales) ---
# DIRECTUS_URL=http://localhost:8055
# ADMIN_TOKEN=

# --- Realtime-server (dev local, sin Docker) ---
# El servidor usa apps/realtime-server/.env si existe; si no, este .env raíz.
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://lookify:cambiar-clave-postgres@localhost:5432/lookify
CORS_ORIGIN=*
LOG_LEVEL=info
PORT=4001

