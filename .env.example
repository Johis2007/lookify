# Copiar a .env -> cp .env.example .env
DB_DATABASE=lookify
DB_USER=lookify
DB_PASSWORD=lookify_pwd_cambiar

DIRECTUS_KEY=cambiar-key-32chars-minimo-123456
DIRECTUS_SECRET=cambiar-secret-32chars-minimo-7890
ADMIN_EMAIL=admin@lookify.app
ADMIN_PASSWORD=Lookify123!
PUBLIC_URL=http://localhost:8055

# Expo app (multi-red con fallback: primaria + lista coma-separada).
# Regenerar al cambiar de Wi-Fi: npm run env:lan [IP]  (conserva ambas redes)
EXPO_PUBLIC_DIRECTUS_URL=http://localhost:8055
EXPO_PUBLIC_DIRECTUS_URLS=http://192.168.1.8:8055,http://10.157.39.169:8055
EXPO_PUBLIC_SOCKET_URL=http://localhost:4001
EXPO_PUBLIC_SOCKET_URLS=http://192.168.1.8:4001,http://10.157.39.169:4001
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Realtime server
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://lookify:lookify_pwd_cambiar@localhost:5432/lookify
# Fase 6: CORS estricto en prod (lista separada por comas). "*" solo DEV.
# En prod lista aquí los orígenes de ambas redes + dominio web, ej.:
# CORS_ORIGIN=http://192.168.1.8:8081,http://10.157.39.169:8081,https://app.lookify.app
CORS_ORIGIN=*
LOG_LEVEL=info
# Fase 7: el realtime verifica el JWT con DIRECTUS_SECRET (mismo valor de arriba).

# Scripts de BD (db:setup / db:seed): URL de Directus + token admin.
# Si ADMIN_TOKEN se deja vacío, los scripts inician sesión con ADMIN_EMAIL/ADMIN_PASSWORD.
# DIRECTUS_URL=http://localhost:8055
# ADMIN_TOKEN=

# Puerto del realtime server (por defecto 4001 si se omite).
# PORT=4001
